# xiboplayer Docker configuration
# Copy to .env and edit. Every value is optional; anything set (non-empty) here
# overrides the same setting in config.json (docker/config/config.json).

# The container serves plain HTTP only; terminate TLS in front of it (nginx).

# ── Container / proxy ────────────────────────────────────────────────────────
# Port published on the host (docker-compose only)
HOST_PORT=8765
# Port the proxy listens on inside the container
# PORT=8765
# Accept self-signed / invalid TLS certificates from the CMS
# RELAX_SSL_CERTS=false
# Allow the CMS to run shell commands in the container (leave off unless needed)
# ALLOW_SHELL_COMMANDS=false
# Version reported in the User-Agent (defaults to the PWA package version)
# APP_VERSION=

# ── CMS connection (shared by every display that loads this server) ──────────
# Leave empty to use the on-screen setup page. Display name and hardware key
# are per-display and are always set on each display, never here.
CMS_URL=
CMS_KEY=
# Optional CMS API client for auto-authorizing the display
API_CLIENT_ID=
API_CLIENT_SECRET=
# LOG_LEVEL=info
# PLAYER_API_BASE=

# Any other PWA config keys, as a JSON object
# PWA_CONFIG_JSON={"transport":"xmds"}
